# SkyShield AI Backend Configuration
PROJECT_NAME="SkyShield AI"
API_V1_STR="/api"
PORT=8000
HOST="0.0.0.0"
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Radar & Signal Processing Defaults
RADAR_CARRIER_FREQ_GHZ=24.0
RADAR_SAMPLING_RATE_HZ=2000
STFT_WINDOW_SIZE=256
STFT_OVERLAP_SIZE=192
SIMULATION_INTERVAL_SEC=1.5

# Database
DATABASE_URL="sqlite:///./skyshield.db"

# Model Mode: "prototype" (DemoClassifier) or "cnn" (CNNClassifier if model weights available)
MODEL_MODE="prototype"
